# ------------------------------------------------------------------
# Vichar AI — API configuration (copy to .env and fill in)
# Never commit real secrets. All values are read from process.env.
# ------------------------------------------------------------------

# Server
API_PORT=4000
NODE_ENV=development

# JSON Web Tokens (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=change-me-generate-a-long-random-string
JWT_REFRESH_SECRET=change-me-generate-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma-separated list of allowed origins (web app URL)
CORS_ORIGINS=http://localhost:3000

# Database
# Default: local SQLite at ./data/vichar.db (zero-config demo).
# Production: set DATABASE_URL to a Supabase PostgreSQL connection string.
DATABASE_URL=

# LLM provider
# "local"  = built-in demo engine (no API key needed, offline-safe)
# "openai" = OpenAI-compatible chat completions API
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Supabase keys (used for storage + production auth integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
